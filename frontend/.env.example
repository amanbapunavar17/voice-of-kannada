# ==========================================
# MAATU (ಮಾತು) — Frontend Environment Config
# ==========================================

# Backend API Base URL (FastAPI)
VITE_API_BASE_URL=http://localhost:8000

# Optional: Supabase Auth & PostgreSQL Integration
# (If omitted, Maatu runs in resilient local-first demo mode with full gamification,
# audio, and certificate generation enabled)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
