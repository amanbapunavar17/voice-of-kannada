# ==========================================
# MAATU (ಮಾತು) — Backend Environment Config
# ==========================================

# Google Gemini API Key for AI Speaking Feedback
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Recommended: gemini-3.8-flash or gemini-2.5-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional: Supabase configuration (if backend validates directly)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
